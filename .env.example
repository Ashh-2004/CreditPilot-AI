# ==============================================================================
# CreditPilot AI - Environment Configuration Template
# Copy this file to .env and replace the values with your local configuration.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=loaniq_db

# Optional dedicated read-only MySQL user for AI SQL Assistant
DB_READONLY_USER=
DB_READONLY_PASSWORD=

# ------------------------------------------------------------------------------
# Security & CORS
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_random_64_char_hex_secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Google Gemini API
# Get an API key from: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
ENVIRONMENT=development
LOG_LEVEL=INFO
